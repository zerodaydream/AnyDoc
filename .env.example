# --- Core ---
APP_ENV=local
DATA_DIR=./var/data
DATABASE_URL=postgresql+psycopg://anydoc:anydoc@localhost:5432/anydoc
CORS_ORIGINS=http://localhost:5173

# --- Local single-user auth stub (replaced by real auth in M-Prod) ---
LOCAL_OWNER_ID=00000000-0000-0000-0000-000000000001
LOCAL_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
# Enables /api/admin/* (send as X-Admin-Token). Empty = admin endpoints return 404. Use a long random value.
ADMIN_TOKEN=

# --- Limits ---
MAX_UPLOAD_MB=100
MAX_PAGES=500
PARSE_TIMEOUT_S=120
PARSE_MEMORY_MB=1024
# Seconds for one CSV table-query plan, run in the parsing sandbox.
QUERY_TIMEOUT_S=30
WORKER_CONCURRENCY=2

# --- LLM (Gemini). Empty key => FakeProvider ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_ANSWER_MODEL=gemini-3.5-flash
LLM_FAST_MODEL=gemini-3.5-flash-lite
FULL_CONTEXT_TOKEN_BUDGET=120000

# --- Groq (optional). With a key, the model picker gets a Groq tab next to Gemini. ---
# Models: GROQ_* keys in backend/config.json. Groq says it keeps no inference data by default; turn on
# Zero Data Retention in console.groq.com > Data Controls. LLM_PROVIDER=groq makes the Groq tab the default.
# GROQ_CONTEXT_TOKEN_BUDGET caps document tokens per answer (free plan: 7,000 input tokens a minute).
GROQ_API_KEY=

# --- Web search tool (used when WEB_SEARCH_ENABLED is on in config.json) ---
# Tavily (free plan: 1,000 searches a month, no card): with a key, WEB_SEARCH_PROVIDER=auto uses it.
# Without one, keyless ddgs (DuckDuckGo + other engines) is used: free, but engines often throttle it.
TAVILY_API_KEY=

# --- Embeddings (local by default) ---
EMBED_PROVIDER=local
EMBED_MODEL=microsoft/harrier-oss-v1-270m
EMBED_DIM=640
EMBED_DEVICE=auto
EMBED_BATCH_SIZE=16
# EMBED_PROVIDER=gemini with EMBED_MODEL=gemini-embedding-2 sends chunk text to Google.
QUOTE_FUZZY_MIN=90

# --- Tracing (LangSmith). Empty key => no-op ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=anydoc-local
# Full document/question content in traces. Dev test documents only.
TRACE_CONTENT=false

# --- Model choices shown in the UI (comma-separated). LLM_ANSWER_MODEL is the default and always included. ---
LLM_MODELS=gemini-4-carbon,gemini-4-neon,gemini-4-hydrogen,gemini-4-argon,gemini-3.1-pro-preview,gemini-3.8-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Thinking levels offered to the user (Gemini ThinkingLevel: minimal, low, medium, high, xhigh)
LLM_THINKING_LEVELS=minimal,low,medium,high,xhigh
LLM_THINKING_DEFAULT=medium
MAX_QUESTION_CHARS=4000
# Per-model levels, JSON {"model":"low,medium,high*"}; "*" = that model's default. Unlisted models use the lists above.
LLM_MODEL_THINKING={"gemini-3.8-flash":"low,medium*,high","gemini-3.6-flash":"minimal,low,medium*,high","gemini-3.5-flash-lite":"minimal*,low,medium,high"}
