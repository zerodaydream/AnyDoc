# --- Core ---
APP_ENV=local
DATA_DIR=./var/data
DATABASE_URL=postgresql+psycopg://anydoc:anydoc@localhost:5432/anydoc
CORS_ORIGINS=http://localhost:5173

# --- Local single-user auth stub (replaced by real auth in M-Prod) ---
LOCAL_OWNER_ID=00000000-0000-0000-0000-000000000001
LOCAL_WORKSPACE_ID=00000000-0000-0000-0000-000000000001

# --- Limits ---
MAX_UPLOAD_MB=100
MAX_PAGES=500
PARSE_TIMEOUT_S=120
PARSE_MEMORY_MB=1024
WORKER_CONCURRENCY=2

# --- LLM (Gemini). Empty key => FakeProvider ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_ANSWER_MODEL=gemini-3.8-flash
LLM_FAST_MODEL=gemini-3.5-flash-lite
LLM_EMBED_MODEL=gemini-embedding-2
LLM_EMBED_DIM=768
FULL_CONTEXT_TOKEN_BUDGET=120000
QUOTE_FUZZY_MIN=90

# --- Tracing (LangSmith). Empty key => no-op ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=anydoc-local
# Full document/question content in traces. Dev test documents only.
TRACE_CONTENT=false
