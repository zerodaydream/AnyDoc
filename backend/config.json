{
  "APP_ENV": "local",
  "LANGSMITH_TRACING": true,
  "LANGSMITH_PROJECT": "anydoc-local",
  "TRACE_CONTENT": false,

  "MAX_UPLOAD_MB": 100,
  "MAX_PAGES": 500,
  "MAX_TEXT_CHARS": 2000000,
  "PARSE_TIMEOUT_S": 120,
  "PARSE_MEMORY_MB": 1024,
  "QUERY_TIMEOUT_S": 30,
  "WORKER_CONCURRENCY": 2,

  "LLM_PROVIDER": "gemini",
  "LLM_ANSWER_MODEL": "gemini-3.5-flash-lite",
  "LLM_FAST_MODEL": "gemini-3.5-flash-lite",
  "FULL_CONTEXT_TOKEN_BUDGET": 120000,
  "QUOTE_FUZZY_MIN": 90,
  "MAX_QUESTION_CHARS": 4000,
  "LLM_THINKING_LEVELS": "minimal,low,medium,high,xhigh",
  "LLM_THINKING_DEFAULT": "medium",
  "MODELS_ENABLED": {
    "gemini-4-neon": "low,medium,high*,xhigh",
    "gemini-4-hydrogen": "low,medium,high*,xhigh",
    "gemini-4-carbon": "low,medium*,high",
    "gemini-4-argon": "low,medium*,high",
    "gemini-3.8-flash": "low,medium*,high",
    "gemini-3.1-pro-preview": "low,medium,high*",
    "gemini-3.6-flash": "minimal,low,medium*,high",
    "gemini-3-flash-preview": "minimal,low,medium*,high",
    "gemini-3.5-flash-lite": "minimal*,low,medium,high",
    "gemini-3.1-flash-lite": "minimal*,low,medium,high"
  },
  "GROQ_ANSWER_MODEL": "qwen/qwen3.8-27b",
  "GROQ_FAST_MODEL": "qwen/qwen3.8-27b",
  "GROQ_MODELS_ENABLED": {
    "qwen/qwen3.8-27b": "off*,low,medium,high",
    "openai/gpt-oss-120b": "low,medium*,high",
    "openai/gpt-oss-20b": "low,medium*,high"
  },

  "WEB_SEARCH_ENABLED": true,
  "WEB_SEARCH_PROVIDER": "auto",
  "WEB_SEARCH_MAX_RESULTS": 5,
  "WEB_SEARCH_TIMEOUT_S": 15,

  "EMBED_PROVIDER": "local",
  "EMBED_MODEL": "microsoft/harrier-oss-v1-270m",
  "EMBED_DIM": 640,
  "EMBED_DEVICE": "auto",
  "EMBED_BATCH_SIZE": 16
}
